# Copy to .env and fill in. .env is gitignored — never commit it.
#
# These are the only settings read from the environment. Everything else about
# how a document is processed lives in pipeline.yaml, which is safe to commit.

# --- MongoDB Atlas (required) ---------------------------------------------
# From Atlas: Connect -> Drivers -> Python. Replace <db_password> including the
# angle brackets. URL-encode any of @ : / ? # [ ] % in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- Embeddings (required) ------------------------------------------------
# A key from dash.voyageai.com starts with "pa-". A key created inside Atlas
# starts with "al-" and only works against ai.mongodb.com — not interchangeable.
VOYAGE_API_KEY=

# Only if EMBED_PROVIDER=openai
OPENAI_API_KEY=

# --- Optional overrides ---------------------------------------------------
# Defaults live in pipeline.yaml; set these to override per machine.
# MONGODB_DB=coc_rag
# MONGODB_COLLECTION=coc_chunks
# VECTOR_INDEX_NAME=coc_vector_index
# EMBED_PROVIDER=voyage
# EMBED_MODEL=voyage-3.5
# EMBED_DIM=1024

# Only if you have pre-downloaded tiktoken's BPE files
# TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
